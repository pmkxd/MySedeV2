<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permisos de almacenamiento -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- Login -->
        <activity
            android:name=".login.ActivityLogin"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <activity
            android:name=".login.ActivityForgotPassword"
            android:exported="false" />

        <!-- Pantallas principales -->
        <activity android:name=".MainActivity" android:exported="true" />
        <activity android:name=".admin.AdminActivity" android:exported="true" />
        <activity android:name=".organizador.OrganizadorActivity" android:exported="true"
            android:label="Organizador de Actividades"
            android:theme="@style/AppTheme" />
        <activity android:name=".programador.ProgramadorActivity" android:exported="true"
            android:label="Programador de Citas"
            android:theme="@style/AppTheme" />
        <activity android:name=".publicista.PublicistaActivity" android:exported="true"
            android:label="Publicista"
            android:theme="@style/AppTheme" />

        <!-- Citas, Actividades y Calendar -->
        <activity android:name=".citas.CrearCitaActivity" android:exported="false" />
        <activity android:name=".actividades.ListarActividadesActivity" android:exported="false" />
        <activity android:name=".CalendarActivity" android:exported="false" />

        <!-- Mantenedores -->
        <activity
            android:name=".mantenedores.mantenedoresActivity"
            android:label="Gestión de Mantenedores"
            android:exported="false"
            android:theme="@style/AppTheme" />

        <!-- Usuarios -->
        <activity
            android:name=".usuarios.GestionUsuariosActivity"
            android:exported="false"
            android:label="Gestión de Usuarios" />
        <activity
            android:name=".usuarios.CrearUsuarioActivity"
            android:exported="false"
            android:label="Crear Usuario" />
        <activity
            android:name=".usuarios.RegistrarUsuarioActivity"
            android:exported="false"
            android:label="Registrar Usuario con Firebase" />
        <activity
            android:name=".usuarios.DetalleUsuarioActivity"
            android:exported="false" />

        <!-- Roles -->
        <activity
            android:name=".auth.SelectorRolActivity"
            android:exported="true"
            android:label="Selector de Rol"
            android:theme="@style/AppTheme" />

        <!-- Otros módulos (tipos, lugares, socios, proyectos, oferentes) -->
        <activity android:name=".tipoactividad.TipoActividadActivity" android:exported="false" />
        <activity android:name=".lugar.LugarActivity" android:exported="false" />
        <activity android:name=".socio.SocioComunitarioActivity" android:exported="false" />
        <activity android:name=".proyecto.ProyectoActivity" android:exported="false" />
        <activity android:name=".oferente.OferenteActivity" android:exported="false" />

    </application>
</manifest>
