<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permisos de almacenamiento -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:requestLegacyExternalStorage="true">

        <!-- Login -->
        <activity android:name=".login.ActivityLogin" android:exported="true">
    </activity>
    <activity android:name=".login.ActivityForgotPassword" android:exported="false" />

    <!-- Pantallas principales -->
        <activity android:name=".MainActivity" android:exported="true"/>
        <activity android:name=".admin.AdminActivity" android:exported="true"/>
        <activity android:name=".organizador.OrganizadorActivity" android:exported="true"/>
        <activity android:name=".programador.ProgramadorActivity" android:exported="true"/>
        <activity android:name=".publicista.PublicistaActivity" android:exported="true"/>

        <!-- Citas, Actividades y Calendar -->
        <activity android:name=".citas.CrearCitaActivity" android:exported="false"/>
        <activity android:name=".actividades.ListarActividadesActivity" android:exported="false"/>
        <activity android:name=".CalendarActivity" android:exported="false"/>

        <!-- Adjuntar archivos -->
        <activity android:name=".AdjuntarArchivosActivity" android:exported="false"/>

        <!-- Mantenedores -->
        <activity android:name=".mantenedores.mantenedoresActivity" android:exported="false"/>

        <!-- Usuarios -->
        <activity android:name=".usuarios.GestionUsuariosActivity" android:exported="false"/>
        <activity android:name=".usuarios.CrearUsuarioActivity" android:exported="false"/>
        <activity android:name=".usuarios.RegistrarUsuarioActivity" android:exported="false"/>
        <activity android:name=".usuarios.DetalleUsuarioActivity" android:exported="false"/>

        <!-- Roles -->
        <activity android:name=".auth.SelectorRolActivity" android:exported="true"/>

        <!-- Otros módulos -->
        <activity android:name=".tipoactividad.TipoActividadActivity" android:exported="false"/>
        <activity android:name=".lugar.LugarActivity" android:exported="false"/>
        <activity android:name=".socio.SocioComunitarioActivity" android:exported="false"/>
        <activity android:name=".proyecto.ProyectoActivity" android:exported="false"/>
        <activity android:name=".oferente.OferenteActivity" android:exported="false"/>

    </application>
</manifest>
