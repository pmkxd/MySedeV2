<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fitsSystemWindows="true">

    <!-- AppBar con elevación y gradiente sutil -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="0dp"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarCambiarContrasena"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="?attr/colorPrimary"
            android:elevation="4dp"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="?attr/colorOnPrimary"
            app:title="@string/cambiar_contrasena_title"
            app:titleTextColor="?attr/colorOnPrimary"
            app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Contenido principal con NestedScrollView -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="32dp"
            android:paddingBottom="32dp">

            <!-- Card principal con todo el contenido -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- Icono decorativo superior -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_gravity="center_horizontal"
                        app:cardCornerRadius="40dp"
                        app:cardElevation="8dp"
                        app:cardBackgroundColor="?attr/colorPrimaryContainer">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center"
                            android:src="@android:drawable/ic_lock_idle_lock"
                            app:tint="?attr/colorOnPrimaryContainer" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Título principal -->
                    <TextView
                        android:id="@+id/txtCambiarContrasenaTitulo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="@string/cambiar_contrasena_title"
                        android:textAlignment="center"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.01" />

                    <!-- Descripción -->
                    <TextView
                        android:id="@+id/txtCambiarContrasenaDescripcion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginHorizontal="16dp"
                        android:text="@string/cambiar_contrasena_description"
                        android:textAlignment="center"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="14sp"
                        android:lineSpacingExtra="4dp" />

                    <!-- Separador decorativo -->
                    <View
                        android:layout_width="80dp"
                        android:layout_height="3dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="24dp"
                        android:layout_marginBottom="24dp"
                        android:background="?attr/colorPrimary"
                        android:alpha="0.3" />

                    <!-- Campo: Contraseña Actual -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilContrasenaActual"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        app:boxCornerRadiusTopStart="16dp"
                        app:boxCornerRadiusTopEnd="16dp"
                        app:boxCornerRadiusBottomStart="16dp"
                        app:boxCornerRadiusBottomEnd="16dp"
                        app:boxStrokeColor="?attr/colorPrimary"
                        app:boxStrokeWidth="2dp"
                        app:hintTextColor="?attr/colorPrimary"
                        app:startIconDrawable="@android:drawable/ic_lock_idle_lock"
                        app:startIconTint="?attr/colorPrimary"
                        app:endIconMode="password_toggle"
                        app:endIconTint="?attr/colorPrimary"
                        app:helperText="Ingresa tu contraseña actual"
                        app:helperTextTextColor="?attr/colorOnSurfaceVariant">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etContrasenaActual"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/cambiar_contrasena_hint_actual"
                            android:inputType="textPassword"
                            android:paddingVertical="16dp"
                            android:textSize="16sp"
                            android:textColor="?attr/colorOnSurface" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Campo: Nueva Contraseña -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilNuevaContrasena"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        app:boxCornerRadiusTopStart="16dp"
                        app:boxCornerRadiusTopEnd="16dp"
                        app:boxCornerRadiusBottomStart="16dp"
                        app:boxCornerRadiusBottomEnd="16dp"
                        app:boxStrokeColor="?attr/colorPrimary"
                        app:boxStrokeWidth="2dp"
                        app:hintTextColor="?attr/colorPrimary"
                        app:startIconDrawable="@android:drawable/ic_lock_idle_lock"
                        app:startIconTint="?attr/colorSecondary"
                        app:endIconMode="password_toggle"
                        app:endIconTint="?attr/colorSecondary"
                        app:helperText="Mínimo 6 caracteres"
                        app:helperTextTextColor="?attr/colorOnSurfaceVariant">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etNuevaContrasena"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/cambiar_contrasena_hint_nueva"
                            android:inputType="textPassword"
                            android:paddingVertical="16dp"
                            android:textSize="16sp"
                            android:textColor="?attr/colorOnSurface" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Campo: Confirmar Contraseña -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilConfirmarContrasena"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        app:boxCornerRadiusTopStart="16dp"
                        app:boxCornerRadiusTopEnd="16dp"
                        app:boxCornerRadiusBottomStart="16dp"
                        app:boxCornerRadiusBottomEnd="16dp"
                        app:boxStrokeColor="?attr/colorPrimary"
                        app:boxStrokeWidth="2dp"
                        app:hintTextColor="?attr/colorPrimary"
                        app:startIconDrawable="@android:drawable/ic_lock_idle_lock"
                        app:startIconTint="?attr/colorTertiary"
                        app:endIconMode="password_toggle"
                        app:endIconTint="?attr/colorTertiary"
                        app:helperText="Confirma tu nueva contraseña"
                        app:helperTextTextColor="?attr/colorOnSurfaceVariant">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etConfirmarContrasena"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/cambiar_contrasena_hint_confirmar"
                            android:inputType="textPassword"
                            android:paddingVertical="16dp"
                            android:textSize="16sp"
                            android:textColor="?attr/colorOnSurface" />
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card de Recomendaciones -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="?attr/colorSecondaryContainer"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Título de recomendaciones con icono -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@android:drawable/ic_dialog_info"
                            app:tint="?attr/colorOnSecondaryContainer" />

                        <TextView
                            android:id="@+id/txtRecomendacionesTitulo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:text="@string/cambiar_contrasena_recomendaciones_title"
                            android:textColor="?attr/colorOnSecondaryContainer"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>

                    <!-- Separador interno -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp"
                        android:background="?attr/colorOnSecondaryContainer"
                        android:alpha="0.2" />

                    <!-- Detalle de recomendaciones -->
                    <TextView
                        android:id="@+id/txtRecomendacionesDetalle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/cambiar_contrasena_recomendaciones"
                        android:textColor="?attr/colorOnSecondaryContainer"
                        android:textSize="14sp"
                        android:lineSpacingExtra="6dp"
                        android:alpha="0.9" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Botón de guardar -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuardarContrasena"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="32dp"
                android:text="@string/cambiar_contrasena_button"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="0.02"
                app:backgroundTint="?attr/colorPrimary"
                app:cornerRadius="16dp"
                app:elevation="4dp"
                app:icon="@android:drawable/ic_menu_save"
                app:iconGravity="textStart"
                app:iconSize="24dp"
                app:iconTint="?attr/colorOnPrimary"
                style="@style/Widget.Material3.Button.ElevatedButton" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>