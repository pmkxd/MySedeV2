<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:padding="24dp"
    tools:context=".login.ActivityLogin">

    <!-- Título -->
    <TextView
        android:id="@+id/txtWelcomeTitleMiSede"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bienvenido a MiSede"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#003C32"
        android:letterSpacing="0.01"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="70dp"/>

    <!-- Subtítulo -->
    <TextView
        android:id="@+id/txtSubTitleMiSede"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ingresa para continuar"
        android:textSize="15sp"
        android:textColor="#005045"
        app:layout_constraintTop_toBottomOf="@id/txtWelcomeTitleMiSede"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="6dp"/>

    <!-- Card Login minimal -->
    <LinearLayout
        android:id="@+id/cardLoginContainerMiSede"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:background="@drawable/bg_login_card_misede"
        android:elevation="3dp"
        app:layout_constraintTop_toBottomOf="@id/txtSubTitleMiSede"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="38dp">

        <!-- Email -->
        <EditText
            android:id="@+id/inputCorreoMiSede"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Correo electrónico"
            android:textColor="#333333"
            android:textColorHint="#A0A6AB"
            android:background="#F2F4F5"
            android:padding="14dp"
            android:inputType="textEmailAddress"
            android:elevation="0dp"
            android:layout_marginBottom="14dp"
            android:backgroundTint="@android:color/transparent"/>

        <!-- Password -->
        <EditText
            android:id="@+id/inputPasswordMiSede"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Contraseña"
            android:textColor="#333333"
            android:textColorHint="#A0A6AB"
            android:background="#F2F4F5"
            android:padding="14dp"
            android:inputType="textPassword"
            android:elevation="0dp"
            android:backgroundTint="@android:color/transparent"/>

        <!-- Botón Login -->
        <Button
            android:id="@+id/btnLoginMiSede"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Iniciar sesión"
            android:backgroundTint="#005A4D"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:layout_marginTop="18dp"
            android:fontFamily="sans-serif-medium"/>
    </LinearLayout>

    <!-- Forgot Password -->
    <TextView
        android:id="@+id/txtForgotPassMiSede"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="¿Olvidó su contraseña?"
        android:textColor="#00796B"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/cardLoginContainerMiSede"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="18dp"
        android:fontFamily="sans-serif-medium"/>
</androidx.constraintlayout.widget.ConstraintLayout>
