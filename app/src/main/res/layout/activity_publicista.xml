<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="#F6F6F8"
    tools:context=".publicista.PublicistaActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Bienvenida -->
        <TextView
            android:id="@+id/txtBienvenida"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bienvenido"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#2B2B2B"
            android:paddingBottom="6dp"/>

        <!-- Nombre Usuario -->
        <TextView
            android:id="@+id/txtNombreUsuario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre Apellido"
            android:textSize="18sp"
            android:textStyle="italic"
            android:textColor="#666666"
            android:paddingBottom="24dp"/>

        <!-- Tarjeta: Actividades -->
        <LinearLayout
            android:id="@+id/cardActividades"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginBottom="12dp"
            android:background="#FFFFFF"
            android:elevation="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Actividades"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#1F4B8B"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Visualiza las actividades del centro."
                android:textSize="14sp"
                android:textColor="#666666"
                android:paddingTop="6dp"
                android:paddingBottom="10dp"/>

            <Button
                android:id="@+id/btnActividades"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ingresar" />
        </LinearLayout>

        <!-- Tarjeta: Calendario -->
        <LinearLayout
            android:id="@+id/cardCalendario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginBottom="12dp"
            android:background="#FFFFFF"
            android:elevation="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Calendario"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#1F4B8B"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Consulta el calendario de citas del centro."
                android:textSize="14sp"
                android:textColor="#666666"
                android:paddingTop="6dp"
                android:paddingBottom="10dp"/>

            <Button
                android:id="@+id/btnCalendario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ingresar" />
        </LinearLayout>

        <!-- Tarjeta: Adjuntar Archivos -->
        <LinearLayout
            android:id="@+id/cardAdjuntar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginBottom="20dp"
            android:background="#FFFFFF"
            android:elevation="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Adjuntar Archivos"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#1F4B8B"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Agrega archivos relacionados con las actividades."
                android:textSize="14sp"
                android:textColor="#666666"
                android:paddingTop="6dp"
                android:paddingBottom="10dp"/>

            <Button
                android:id="@+id/btnAdjuntar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Adjuntar" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
