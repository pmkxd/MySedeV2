<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_container"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <!-- Header Premium con gradiente visual -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="0dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="?attr/colorPrimaryContainer">


    </com.google.android.material.card.MaterialCardView>

    <!-- Contenido desplazable con padding mejorado -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="96dp"
        android:clipToPadding="false"
        android:scrollbars="none"
        android:background="?attr/colorSurface">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- CARD: Tipos de Actividad -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_tipo_actividad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                app:cardElevation="4dp"
                app:cardCornerRadius="20dp"
                app:strokeWidth="0dp"
                android:clickable="true"
                android:focusable="true"
                app:rippleColor="?attr/colorPrimary">

                <LinearLayout
                    android:orientation="horizontal"
                    android:padding="20dp"
                    android:gravity="center_vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- Badge con icono -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        app:cardCornerRadius="28dp"
                        app:cardElevation="6dp"
                        app:cardBackgroundColor="?attr/colorPrimaryContainer">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_tipo_actividad"
                            app:tint="?attr/colorOnPrimaryContainer"
                            android:contentDescription="Icono tipo actividad" />

                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_marginStart="16dp"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content">

                        <TextView
                            android:text="Tipos de Actividad"
                            android:textStyle="bold"
                            android:textSize="18sp"
                            android:textColor="?attr/colorOnSurface"
                            android:fontFamily="sans-serif-medium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:text="Gestión de categorías de actividades"
                            android:textSize="13sp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:alpha="0.85"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <!-- Indicador chevron -->
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/ic_menu_more"
                        app:tint="?attr/colorOnSurfaceVariant"
                        android:alpha="0.5"
                        android:rotation="270"
                        android:contentDescription="Ver más" />

                </LinearLayout>

                <!-- Barra decorativa inferior -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_gravity="bottom"
                    android:background="?attr/colorPrimary"
                    android:alpha="0.3" />

            </com.google.android.material.card.MaterialCardView>

            <!-- CARD: Lugares -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_lugares"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                app:cardElevation="4dp"
                app:cardCornerRadius="20dp"
                app:strokeWidth="0dp"
                android:clickable="true"
                android:focusable="true"
                app:rippleColor="?attr/colorSecondary">

                <LinearLayout
                    android:orientation="horizontal"
                    android:padding="20dp"
                    android:gravity="center_vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- Badge con icono -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        app:cardCornerRadius="28dp"
                        app:cardElevation="6dp"
                        app:cardBackgroundColor="?attr/colorSecondaryContainer">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_lugar"
                            app:tint="?attr/colorOnSecondaryContainer"
                            android:contentDescription="Icono lugar" />

                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_marginStart="16dp"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content">

                        <TextView
                            android:text="Lugares"
                            android:textStyle="bold"
                            android:textSize="18sp"
                            android:textColor="?attr/colorOnSurface"
                            android:fontFamily="sans-serif-medium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:text="Salas y espacios disponibles"
                            android:textSize="13sp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:alpha="0.85"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <!-- Indicador chevron -->
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/ic_menu_more"
                        app:tint="?attr/colorOnSurfaceVariant"
                        android:alpha="0.5"
                        android:rotation="270"
                        android:contentDescription="Ver más" />

                </LinearLayout>

                <!-- Barra decorativa inferior -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_gravity="bottom"
                    android:background="?attr/colorSecondary"
                    android:alpha="0.3" />

            </com.google.android.material.card.MaterialCardView>

            <!-- CARD: Oferentes -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_oferentes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                app:cardElevation="4dp"
                app:cardCornerRadius="20dp"
                app:strokeWidth="0dp"
                android:clickable="true"
                android:focusable="true"
                app:rippleColor="?attr/colorTertiary">

                <LinearLayout
                    android:orientation="horizontal"
                    android:padding="20dp"
                    android:gravity="center_vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- Badge con icono -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        app:cardCornerRadius="28dp"
                        app:cardElevation="6dp"
                        app:cardBackgroundColor="?attr/colorTertiaryContainer">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_oferente"
                            app:tint="?attr/colorOnTertiaryContainer"
                            android:contentDescription="Icono oferente" />

                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_marginStart="16dp"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content">

                        <TextView
                            android:text="Oferentes"
                            android:textStyle="bold"
                            android:textSize="18sp"
                            android:textColor="?attr/colorOnSurface"
                            android:fontFamily="sans-serif-medium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:text="Personas o instituciones que dictan actividades"
                            android:textSize="13sp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:alpha="0.85"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <!-- Indicador chevron -->
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/ic_menu_more"
                        app:tint="?attr/colorOnSurfaceVariant"
                        android:alpha="0.5"
                        android:rotation="270"
                        android:contentDescription="Ver más" />

                </LinearLayout>

                <!-- Barra decorativa inferior -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_gravity="bottom"
                    android:background="?attr/colorTertiary"
                    android:alpha="0.3" />

            </com.google.android.material.card.MaterialCardView>

            <!-- CARD: Socios -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_socios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                app:cardElevation="4dp"
                app:cardCornerRadius="20dp"
                app:strokeWidth="0dp"
                android:clickable="true"
                android:focusable="true"
                app:rippleColor="?attr/colorPrimary">

                <LinearLayout
                    android:orientation="horizontal"
                    android:padding="20dp"
                    android:gravity="center_vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- Badge con icono -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        app:cardCornerRadius="28dp"
                        app:cardElevation="6dp"
                        app:cardBackgroundColor="?attr/colorPrimaryContainer">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_socio"
                            app:tint="?attr/colorOnPrimaryContainer"
                            android:contentDescription="Icono socio" />

                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_marginStart="16dp"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content">

                        <TextView
                            android:text="Socios Comunitarios"
                            android:textStyle="bold"
                            android:textSize="18sp"
                            android:textColor="?attr/colorOnSurface"
                            android:fontFamily="sans-serif-medium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:text="Organizaciones externas asociadas"
                            android:textSize="13sp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:alpha="0.85"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <!-- Indicador chevron -->
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/ic_menu_more"
                        app:tint="?attr/colorOnSurfaceVariant"
                        android:alpha="0.5"
                        android:rotation="270"
                        android:contentDescription="Ver más" />

                </LinearLayout>

                <!-- Barra decorativa inferior -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_gravity="bottom"
                    android:background="?attr/colorPrimary"
                    android:alpha="0.3" />

            </com.google.android.material.card.MaterialCardView>

            <!-- CARD: Proyectos -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_proyectos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                app:cardElevation="4dp"
                app:cardCornerRadius="20dp"
                app:strokeWidth="0dp"
                android:clickable="true"
                android:focusable="true"
                app:rippleColor="?attr/colorSecondary">

                <LinearLayout
                    android:orientation="horizontal"
                    android:padding="20dp"
                    android:gravity="center_vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- Badge con icono -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        app:cardCornerRadius="28dp"
                        app:cardElevation="6dp"
                        app:cardBackgroundColor="?attr/colorSecondaryContainer">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_proyecto"
                            app:tint="?attr/colorOnSecondaryContainer"
                            android:contentDescription="Icono proyecto" />

                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_marginStart="16dp"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content">

                        <TextView
                            android:text="Proyectos"
                            android:textStyle="bold"
                            android:textSize="18sp"
                            android:textColor="?attr/colorOnSurface"
                            android:fontFamily="sans-serif-medium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:text="Programas y convocatorias"
                            android:textSize="13sp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:alpha="0.85"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <!-- Indicador chevron -->
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/ic_menu_more"
                        app:tint="?attr/colorOnSurfaceVariant"
                        android:alpha="0.5"
                        android:rotation="270"
                        android:contentDescription="Ver más" />

                </LinearLayout>

                <!-- Barra decorativa inferior -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_gravity="bottom"
                    android:background="?attr/colorSecondary"
                    android:alpha="0.3" />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>