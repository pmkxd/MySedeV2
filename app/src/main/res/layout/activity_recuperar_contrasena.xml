<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9FB"
    android:padding="24dp"
    tools:context=".login.ActivityForgotPassword">

    <!-- Título -->
    <TextView
        android:id="@+id/txtResetTitleMiSede"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Recuperar contraseña"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#004D40"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="80dp"/>

    <!-- Subtítulo -->
    <TextView
        android:id="@+id/txtResetSubMiSede"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ingresa tu correo para restablecer tu acceso"
        android:textSize="15sp"
        android:textColor="#546E7A"
        app:layout_constraintTop_toBottomOf="@id/txtResetTitleMiSede"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"/>

    <!-- Campo Correo -->
    <EditText
        android:id="@+id/inputEmailResetMiSede"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Correo electrónico"
        android:inputType="textEmailAddress"
        android:padding="14dp"
        android:layout_marginTop="40dp"
        android:background="@android:drawable/edit_text"
        app:layout_constraintTop_toBottomOf="@id/txtResetSubMiSede"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Botón enviar -->
    <Button
        android:id="@+id/btnResetPasswordMiSede"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Enviar enlace"
        android:textAllCaps="false"
        android:padding="14dp"
        android:backgroundTint="#004D40"
        android:textColor="#FFFFFF"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/inputEmailResetMiSede"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
