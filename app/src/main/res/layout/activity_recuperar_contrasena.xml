<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:padding="24dp"
    tools:context=".login.ActivityForgotPassword"
    android:fitsSystemWindows="true">

    <!-- Gradient Background decorativo -->
    <View
        android:id="@+id/gradient_background"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:background="@drawable/bg_gradient_top"
        android:alpha="0.4"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Botón Volver (Flecha atrás) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBackToLogin"
        android:layout_width="48dp"
        android:layout_height="48dp"
        style="@style/Widget.Material3.Button.IconButton"
        app:icon="@drawable/ic_arrow_back"
        app:iconTint="?attr/colorOnSurface"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="8dp"
        android:contentDescription="Volver"/>

    <!-- Icono principal (candado con interrogación) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/icon_container"
        android:layout_width="80dp"
        android:layout_height="80dp"
        app:cardCornerRadius="40dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="?attr/colorSecondaryContainer"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="70dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_lock_reset"
            android:tint="?attr/colorOnSecondaryContainer"
            tools:ignore="UseAppTint"/>
    </androidx.cardview.widget.CardView>

    <!-- Título -->
    <TextView
        android:id="@+id/txtResetTitleMiSede"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Recuperar contraseña"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface"
        android:letterSpacing="0.02"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/icon_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp"/>

    <!-- Subtítulo -->
    <TextView
        android:id="@+id/txtResetSubMiSede"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Ingresa tu correo electrónico y te enviaremos un enlace para restablecer tu contraseña"
        android:textSize="14sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:alpha="0.87"
        android:gravity="center"
        android:letterSpacing="0.01"
        android:lineSpacingExtra="2dp"
        app:layout_constraintTop_toBottomOf="@id/txtResetTitleMiSede"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>

    <!-- Card contenedor del formulario -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardResetContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="24dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
        app:strokeWidth="0dp"
        app:layout_constraintTop_toBottomOf="@id/txtResetSubMiSede"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="28dp">

            <!-- Campo Email con Material TextInputLayout -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/emailResetInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Correo electrónico"
                app:boxBackgroundMode="filled"
                app:boxBackgroundColor="?attr/colorSurfaceContainer"
                app:boxCornerRadiusTopStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxStrokeWidth="0dp"
                app:boxStrokeWidthFocused="2dp"
                app:boxStrokeColor="?attr/colorPrimary"
                app:hintTextColor="?attr/colorPrimary"
                app:startIconDrawable="@drawable/ic_email"
                app:startIconTint="?attr/colorOnSurfaceVariant"
                app:endIconMode="clear_text"
                app:endIconTint="?attr/colorOnSurfaceVariant"
                app:helperText="Te enviaremos un enlace de recuperación"
                app:helperTextTextColor="?attr/colorOnSurfaceVariant"
                android:layout_marginBottom="20dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputEmailResetMiSede"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp"
                    android:paddingTop="18dp"
                    android:paddingBottom="18dp"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Botón Enviar enlace -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResetPasswordMiSede"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Enviar enlace"
                android:textSize="16sp"
                android:textAllCaps="false"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.02"
                app:cornerRadius="16dp"
                app:elevation="2dp"
                app:backgroundTint="?attr/colorPrimary"
                android:textColor="?attr/colorOnPrimary"
                app:icon="@drawable/ic_send"
                app:iconGravity="end"
                app:iconTint="?attr/colorOnPrimary"
                app:iconSize="20dp"
                app:rippleColor="?attr/colorPrimaryContainer"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Información adicional -->
    <LinearLayout
        android:id="@+id/info_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="16dp"
        android:background="@drawable/bg_info_box"
        app:layout_constraintTop_toBottomOf="@id/cardResetContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_info"
            android:tint="?attr/colorPrimary"
            android:layout_marginEnd="8dp"
            tools:ignore="UseAppTint"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Revisa tu bandeja de entrada y spam"
            android:textSize="13sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:alpha="0.8"/>
    </LinearLayout>

    <!-- Texto volver al login -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¿Recordaste tu contraseña?"
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurfaceVariant"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGoToLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Iniciar sesión"
            android:textColor="?attr/colorPrimary"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            style="@style/Widget.Material3.Button.TextButton"
            android:minWidth="0dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>