<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cancelar_cita_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_surface"
    tools:context=".citas.CancelarCitaActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/md_theme_primary"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:title="@string/cancelar_cita_title"
        android:titleTextColor="@color/md_theme_onPrimary"
        app:titleCentered="false" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/cancelar_cita_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="?attr/actionBarSize"
        android:paddingHorizontal="20dp"
        android:paddingBottom="24dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="20dp"
            android:gravity="center_horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cancelar_cita_detalle_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:background="@color/md_theme_surfaceContainerLow"
                app:cardElevation="0dp"
                app:strokeColor="@color/md_theme_outlineVariant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/cancelar_cita_detalle_title"
                        style="@style/TextAppearance.Material3.TitleMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cancelar_cita_detalle_title"
                        android:textColor="@color/md_theme_onSurface" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/cancelar_cita_detalle_text"
                        style="@style/TextAppearance.Material3.BodyLarge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="@color/md_theme_onSurfaceVariant"
                        tools:text="Actividad: Orientación nutricional\nLugar: Sede Central\nFecha: 23 mayo 2024\nHora: 10:30" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/cancelar_cita_detalle_aviso"
                        style="@style/TextAppearance.Material3.BodySmall"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="@color/md_theme_onSurfaceVariant"
                        tools:text="Aviso programado para 21 mayo 2024 10:30" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/cancelar_cita_motivo_label"
                style="@style/TextAppearance.Material3.TitleSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cancelar_cita_motivo_label"
                android:textColor="@color/md_theme_onSurface"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/cancelar_cita_layout_motivo"
                style="@style/Widget.Material3.TextInputLayout.FilledBox.Dense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="@string/cancelar_cita_hint_motivo"
                app:startIconDrawable="@drawable/ic_warning"
                app:startIconTint="@color/md_theme_error">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/cancelar_cita_input_motivo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:minLines="3"
                    android:inputType="textMultiLine"
                    android:textColor="@color/md_theme_onSurface" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/cancelar_cita_switch_notificar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cancelar_cita_switch_notificar"
                android:textColor="@color/md_theme_onSurface"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cancelar_cita_check_confirmacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cancelar_cita_check_confirmacion"
                android:textColor="@color/md_theme_onSurface"
                android:layout_marginBottom="20dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cancelar_cita_btn_confirmar"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cancelar_cita_btn_confirmar"
                android:textAllCaps="false"
                app:backgroundTint="@color/md_theme_error"
                android:textColor="@color/md_theme_onError" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cancelar_cita_btn_rechazar"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/cancelar_cita_btn_rechazar"
                android:textAllCaps="false" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cancelar_cita_resumen_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:visibility="gone"
                android:background="@color/md_theme_errorContainer"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/cancelar_cita_resumen_title"
                        style="@style/TextAppearance.Material3.TitleMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cancelar_cita_resumen_title"
                        android:textColor="@color/md_theme_onErrorContainer" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/cancelar_cita_resumen_text"
                        style="@style/TextAppearance.Material3.BodyLarge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="@color/md_theme_onErrorContainer"
                        tools:text="Cita cancelada. Se notificará al socio comunitario." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>