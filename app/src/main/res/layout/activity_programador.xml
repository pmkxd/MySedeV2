<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="#F6F6F8"
    tools:context=".programador.ProgramadorActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Bienvenida -->
        <TextView
            android:id="@+id/txtBienvenida"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bienvenido"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#2B2B2B"
            android:paddingBottom="6dp"/>

        <!-- Nombre Usuario -->
        <TextView
            android:id="@+id/txtNombreUsuario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre Apellido"
            android:textSize="18sp"
            android:textStyle="italic"
            android:textColor="#666666"
            android:paddingBottom="24dp"/>

        <!-- Tarjeta: Crear Cita -->
        <LinearLayout
            android:id="@+id/cardCrearCita"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginBottom="12dp"
            android:background="#FFFFFF"
            android:elevation="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Crear Cita"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#1F4B8B"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Permite crear nuevas citas para usuarios."
                android:textSize="14sp"
                android:textColor="#666666"
                android:paddingTop="6dp"
                android:paddingBottom="10dp"/>

            <Button
                android:id="@+id/btnCrearCita"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ingresar" />
        </LinearLayout>

        <!-- Tarjeta: Listar/Editar Citas -->
        <LinearLayout
            android:id="@+id/cardListarCitas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginBottom="12dp"
            android:background="#FFFFFF"
            android:elevation="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gestionar Citas"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#1F4B8B"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Visualiza, edita o cancela citas existentes."
                android:textSize="14sp"
                android:textColor="#666666"
                android:paddingTop="6dp"
                android:paddingBottom="10dp"/>

            <Button
                android:id="@+id/btnGestionCitas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ingresar" />
        </LinearLayout>

        <!-- Tarjeta: Calendario -->
        <LinearLayout
            android:id="@+id/cardCalendario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginBottom="20dp"
            android:background="#FFFFFF"
            android:elevation="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Calendario"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#1F4B8B"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Visualiza todas las citas en el calendario del centro."
                android:textSize="14sp"
                android:textColor="#666666"
                android:paddingTop="6dp"
                android:paddingBottom="10dp"/>

            <Button
                android:id="@+id/btnCalendario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ingresar" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
